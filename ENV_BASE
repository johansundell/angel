# true logs the route table and an access log line per request
DEBUG=false
PORT=:8080
# true serves assets/ and tmpl/ from next to the binary; needs a built binary, not go run
USE_FILE_SYSTEM=false
TIMEOUT=15
# optional path to sqlite database file (defaults to <binary dir>/<nameOfService>.db)
SQLITE_PATH=""
# keypad PINs (required): caregivers enter exactly 4 digits, the client 4-12 digits
CAREGIVER_PIN=""
MASTER_PIN=""
# how long a caregiver session lasts, between 15m and 30m (replaces the
# deprecated SESSION_TIMEOUT, which is still read when this is unset)
CAREGIVER_SESSION_TIMEOUT="20m"
# how long a client (Master PIN) session lasts, between 15m and 24h
CLIENT_SESSION_TIMEOUT="8h"
# signs session cookies, at least 32 characters; leave empty to generate one per
# start (everyone then enters the PIN again after a restart)
SESSION_SECRET=""
# false only when testing over plain HTTP on another host than localhost
COOKIE_SECURE=true
# true shows Caregivers each other's first names with the times of today's
# Acknowledgements; anyone with the shared Caregiver PIN then sees who visits
# and when (docs/adr/0006-caregiver-names-opt-in.md)
SHARE_CAREGIVER_NAMES=false
# comma-separated proxy IPs/CIDRs whose X-Forwarded-For is trusted, e.g.
# 127.0.0.1 behind cloudflared or a local reverse proxy; empty trusts none
TRUSTED_PROXIES=""
# docker-compose.https.yml only (Caddy in front of Angel, see README): the
# host name Angel is served on, an optional e-mail for certificate expiry
# warnings, and an optional ACME directory, e.g. Let's Encrypt staging
# https://acme-staging-v02.api.letsencrypt.org/directory for the first run
DOMAIN=""
ACME_EMAIL=""
ACME_CA=""
# docker-compose.https.yml only: the published image tag to run, e.g. v0.0.2;
# empty runs latest
VERSION=""
